{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagicTrainer",
  "version": "1.0.0",
  "identifier": "com.goobentertainment.magictrainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MagicTrainer",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://mtimg.localhost https://cards.scryfall.io",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: blob: http://mtimg.localhost https://cards.scryfall.io http://localhost:1420",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 http://127.0.0.1:1421",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../knowledge/mtg-rules/CR-S*_*.txt": "knowledge/mtg-rules/",
      "../../knowledge/mtg-rules/CR-GLOSSARY_*.txt": "knowledge/mtg-rules/"
    }
  }
}